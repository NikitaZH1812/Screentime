# Copy to .env.local (git-ignored) and fill in.
# themoviedb.org → Settings → API. Either a v3 key or a v4 bearer token works.
TMDB_API_KEY=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# supabase.com project → Settings → API. The anon (public) key, not service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
